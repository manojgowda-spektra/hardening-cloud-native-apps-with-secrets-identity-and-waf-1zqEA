{
  "$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "azureUserName": {
      "type": "string"
    },
    "azurePassword": {
      "type": "securestring"
    },
    "ODLID": {
      "type": "string"
    },
    "DeploymentID": {
      "type": "string"
    },
    "adminUsername": {
      "type": "string"
    },
    "adminPassword": {
      "type": "securestring"
    },
    "trainerUserName": {
      "type": "string"
    },
    "trainerUserPassword": {
      "type": "string"
    }
  },
  "variables": {
    "scripturl": "[uri(deployment().properties.templateLink.uri, 'psscript-01.ps1')]",
    "LabVMName": "zava-web-vm",
    "vnetName": "zava-vnet",
    "appSubnetName": "app-subnet",
    "appgwSubnetName": "appgw-subnet",
    "nsgName": "zava-app-nsg",
    "nicName": "zava-web-nic",
    "publicIpName": "zava-web-pip",
    "legacyIdentityName": "zava-app-legacy-id",
    "workspaceName": "[concat('law-zava-', uniqueString(resourceGroup().id))]",
    "shutdownScheduleName": "[concat('shutdown-computevm-', variables('LabVMName'))]",
    "contributorRoleDefinitionId": "b24988ac-6180-42a0-ab88-20f7382dd24c",
    "legacyContributorAssignmentName": "[guid(resourceGroup().id, variables('legacyIdentityName'), variables('contributorRoleDefinitionId'))]",
    "vnetAddressPrefix": "10.40.0.0/16",
    "appSubnetPrefix": "10.40.1.0/24",
    "appgwSubnetPrefix": "10.40.2.0/24",
    "sampleConnectionString": "Server=tcp:zava-sample.database.windows.net,1433;Initial Catalog=ZavaRetailSample;User ID=zava_app;Password=PlaintextSampleOnly!2026;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;"
  },
  "resources": [
    {
      "type": "Microsoft.Network/networkSecurityGroups",
      "apiVersion": "2024-05-01",
      "name": "[variables('nsgName')]",
      "location": "[resourceGroup().location]",
      "tags": {
        "lab": "zava-retail",
        "purpose": "initial-insecure-direct-http"
      },
      "properties": {
        "securityRules": [
          {
            "name": "Allow-HTTP-Direct-Internet",
            "properties": {
              "description": "Initial insecure baseline: direct public HTTP to the storefront VM. Learners remove or block this later.",
              "protocol": "Tcp",
              "sourcePortRange": "*",
              "destinationPortRange": "80",
              "sourceAddressPrefix": "Internet",
              "destinationAddressPrefix": "*",
              "access": "Allow",
              "priority": 100,
              "direction": "Inbound"
            }
          },
          {
            "name": "Allow-RDP-LabAccess",
            "properties": {
              "description": "Allows lab RDP/VM Shadow access to the Windows VM.",
              "protocol": "Tcp",
              "sourcePortRange": "*",
              "destinationPortRange": "3389",
              "sourceAddressPrefix": "Internet",
              "destinationAddressPrefix": "*",
              "access": "Allow",
              "priority": 110,
              "direction": "Inbound"
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.Network/virtualNetworks",
      "apiVersion": "2024-05-01",
      "name": "[variables('vnetName')]",
      "location": "[resourceGroup().location]",
      "tags": {
        "lab": "zava-retail"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/networkSecurityGroups', variables('nsgName'))]"
      ],
      "properties": {
        "addressSpace": {
          "addressPrefixes": [
            "[variables('vnetAddressPrefix')]"
          ]
        },
        "subnets": [
          {
            "name": "[variables('appSubnetName')]",
            "properties": {
              "addressPrefix": "[variables('appSubnetPrefix')]",
              "networkSecurityGroup": {
                "id": "[resourceId('Microsoft.Network/networkSecurityGroups', variables('nsgName'))]"
              }
            }
          },
          {
            "name": "[variables('appgwSubnetName')]",
            "properties": {
              "addressPrefix": "[variables('appgwSubnetPrefix')]"
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.Network/publicIPAddresses",
      "apiVersion": "2024-05-01",
      "name": "[variables('publicIpName')]",
      "location": "[resourceGroup().location]",
      "sku": {
        "name": "Standard",
        "tier": "Regional"
      },
      "tags": {
        "lab": "zava-retail",
        "purpose": "initial-direct-vm-access"
      },
      "properties": {
        "publicIPAllocationMethod": "Static",
        "publicIPAddressVersion": "IPv4",
        "idleTimeoutInMinutes": 4,
        "dnsSettings": {
          "domainNameLabel": "[toLower(concat('zava-', parameters('DeploymentID')))]"
        }
      }
    },
    {
      "type": "Microsoft.Network/networkInterfaces",
      "apiVersion": "2024-05-01",
      "name": "[variables('nicName')]",
      "location": "[resourceGroup().location]",
      "tags": {
        "lab": "zava-retail"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/publicIPAddresses', variables('publicIpName'))]",
        "[resourceId('Microsoft.Network/virtualNetworks', variables('vnetName'))]"
      ],
      "properties": {
        "ipConfigurations": [
          {
            "name": "ipconfig1",
            "properties": {
              "privateIPAllocationMethod": "Dynamic",
              "subnet": {
                "id": "[resourceId('Microsoft.Network/virtualNetworks/subnets', variables('vnetName'), variables('appSubnetName'))]"
              },
              "publicIPAddress": {
                "id": "[resourceId('Microsoft.Network/publicIPAddresses', variables('publicIpName'))]"
              }
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.ManagedIdentity/userAssignedIdentities",
      "apiVersion": "2023-01-31",
      "name": "[variables('legacyIdentityName')]",
      "location": "[resourceGroup().location]",
      "tags": {
        "lab": "zava-retail",
        "purpose": "legacy-overprivileged-identity"
      }
    },
    {
      "type": "Microsoft.Compute/virtualMachines",
      "apiVersion": "2024-11-01",
      "name": "[variables('LabVMName')]",
      "location": "[resourceGroup().location]",
      "plan": {
        "name": "win2019",
        "publisher": "spektra",
        "product": "cloudlabs-windows-jumpvm"
      },
      "tags": {
        "lab": "zava-retail",
        "role": "storefront"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/networkInterfaces', variables('nicName'))]"
      ],
      "properties": {
        "hardwareProfile": {
          "vmSize": "Standard_B2s"
        },
        "osProfile": {
          "computerName": "[variables('LabVMName')]",
          "adminUsername": "[parameters('adminUsername')]",
          "adminPassword": "[parameters('adminPassword')]",
          "windowsConfiguration": {
            "provisionVMAgent": true,
            "enableAutomaticUpdates": true,
            "patchSettings": {
              "patchMode": "AutomaticByOS"
            }
          }
        },
        "storageProfile": {
          "imageReference": {
            "publisher": "Spektra",
            "offer": "cloudlabs-windows-jumpvm",
            "sku": "win2019",
            "version": "latest"
          },
          "osDisk": {
            "createOption": "FromImage",
            "managedDisk": {
              "storageAccountType": "StandardSSD_LRS"
            }
          }
        },
        "networkProfile": {
          "networkInterfaces": [
            {
              "id": "[resourceId('Microsoft.Network/networkInterfaces', variables('nicName'))]"
            }
          ]
        },
        "diagnosticsProfile": {
          "bootDiagnostics": {
            "enabled": true
          }
        }
      }
    },
    {
      "type": "Microsoft.DevTestLab/schedules",
      "apiVersion": "2018-09-15",
      "name": "[variables('shutdownScheduleName')]",
      "location": "[resourceGroup().location]",
      "tags": {
        "lab": "zava-retail",
        "purpose": "cloudlabs-vm-auto-shutdown"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Compute/virtualMachines', variables('LabVMName'))]"
      ],
      "properties": {
        "status": "Disabled",
        "taskType": "ComputeVmShutdownTask",
        "targetResourceId": "[resourceId('Microsoft.Compute/virtualMachines', variables('LabVMName'))]",
        "timeZoneId": "UTC",
        "dailyRecurrence": {
          "time": "1900"
        },
        "notificationSettings": {
          "status": "Disabled",
          "timeInMinutes": 30,
          "emailRecipient": "",
          "webhookUrl": ""
        }
      }
    },
    {
      "type": "Microsoft.Compute/virtualMachines/extensions",
      "apiVersion": "2024-11-01",
      "name": "[concat(variables('LabVMName'), '/zava-storefront-bootstrap')]",
      "location": "[resourceGroup().location]",
      "dependsOn": [
        "[resourceId('Microsoft.Compute/virtualMachines', variables('LabVMName'))]"
      ],
      "properties": {
        "publisher": "Microsoft.Compute",
        "type": "CustomScriptExtension",
        "typeHandlerVersion": "1.10",
        "autoUpgradeMinorVersion": true,
        "settings": {
          "fileUris": [
            "[variables('scripturl')]"
          ]
        },
        "protectedSettings": {
          "commandToExecute": "[concat('powershell.exe -ExecutionPolicy Unrestricted -File psscript-01.ps1 -AzureUserName \"', parameters('azureUserName'), '\" -AzurePassword \"', parameters('azurePassword'), '\" -AzureTenantID \"', tenant().tenantId, '\" -AzureSubscriptionID \"', subscription().subscriptionId, '\" -DeploymentID \"', parameters('DeploymentID'), '\" -ODLID \"', parameters('ODLID'), '\" -vmAdminUsername \"', parameters('adminUsername'), '\" -vmAdminPassword \"', parameters('adminPassword'), '\" -trainerUserName \"', parameters('trainerUserName'), '\" -trainerUserPassword \"', parameters('trainerUserPassword'), '\"')]"
        }
      }
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[variables('legacyContributorAssignmentName')]",
      "dependsOn": [
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('legacyIdentityName'))]"
      ],
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('contributorRoleDefinitionId'))]",
        "principalId": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('legacyIdentityName')), '2023-01-31').principalId]",
        "principalType": "ServicePrincipal",
        "description": "Initial lab baseline: legacy identity intentionally has excessive Contributor at resource-group scope."
      }
    },
    {
      "type": "Microsoft.OperationalInsights/workspaces",
      "apiVersion": "2023-09-01",
      "name": "[variables('workspaceName')]",
      "location": "[resourceGroup().location]",
      "tags": {
        "lab": "zava-retail",
        "purpose": "learner-application-gateway-diagnostics"
      },
      "properties": {
        "sku": {
          "name": "PerGB2018"
        },
        "retentionInDays": 30,
        "features": {
          "enableLogAccessUsingOnlyResourcePermissions": true
        },
        "workspaceCapping": {
          "dailyQuotaGb": 1
        },
        "publicNetworkAccessForIngestion": "Enabled",
        "publicNetworkAccessForQuery": "Enabled"
      }
    }
  ],
  "outputs": {
    "vmServerDnsName": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Network/publicIPAddresses', variables('publicIpName')), '2024-05-01').dnsSettings.fqdn]"
    },
    "vmServerUsername": {
      "type": "string",
      "value": "[parameters('adminUsername')]"
    },
    "vmServerPassword": {
      "type": "string",
      "value": "[parameters('adminPassword')]"
    },
    "trainerUserName": {
      "type": "string",
      "value": "[parameters('trainerUserName')]"
    },
    "trainerUserPassword": {
      "type": "string",
      "value": "[parameters('trainerUserPassword')]"
    },
    "resourceGroupName": {
      "type": "string",
      "value": "[resourceGroup().name]"
    },
    "zavaWebVmName": {
      "type": "string",
      "value": "[variables('LabVMName')]"
    },
    "zavaWebVmPublicIp": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Network/publicIPAddresses', variables('publicIpName')), '2024-05-01').ipAddress]"
    },
    "storefrontUrl": {
      "type": "string",
      "value": "[concat('http://', reference(resourceId('Microsoft.Network/publicIPAddresses', variables('publicIpName')), '2024-05-01').ipAddress)]"
    },
    "zavaVnetName": {
      "type": "string",
      "value": "[variables('vnetName')]"
    },
    "appSubnetName": {
      "type": "string",
      "value": "[variables('appSubnetName')]"
    },
    "appgwSubnetName": {
      "type": "string",
      "value": "[variables('appgwSubnetName')]"
    },
    "legacyIdentityName": {
      "type": "string",
      "value": "[variables('legacyIdentityName')]"
    },
    "logAnalyticsWorkspaceName": {
      "type": "string",
      "value": "[variables('workspaceName')]"
    },
    "logAnalyticsWorkspaceResourceId": {
      "type": "string",
      "value": "[resourceId('Microsoft.OperationalInsights/workspaces', variables('workspaceName'))]"
    },
    "sampleConnectionString": {
      "type": "string",
      "value": "[variables('sampleConnectionString')]"
    }
  }
}
